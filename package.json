{
  "name": "rapid-prompt-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "desktop:dev": "npm run desktop:repair-electron && npm --workspace @rapid-prompt/desktop run dev",
    "desktop:build": "npm --workspace @rapid-prompt/desktop run build",
    "desktop:preview": "npm --workspace @rapid-prompt/desktop run preview",
    "api:dev": "npm --workspace @rapid-prompt/prompt-sync-api run dev",
    "api:build": "npm --workspace @rapid-prompt/prompt-sync-api run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "desktop:repair-electron": "node tools/repair-electron-install.mjs",
    "desktop:package:mac": "npm --workspace @rapid-prompt/desktop run package:mac",
    "desktop:package:mac:dir": "npm --workspace @rapid-prompt/desktop run package:mac:dir",
    "clean": "node tools/clean-rebuild.mjs",
    "rebuild:fresh": "node tools/clean-rebuild.mjs --install --repair-electron --build",
    "rebuild:fresh:mac": "node tools/clean-rebuild.mjs --install --repair-electron --package-mac",
    "rebuild:fresh:keep-lock": "node tools/clean-rebuild.mjs --keep-lockfiles --install --repair-electron --build"
  },
  "devDependencies": {
    "electron": "42.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
